# Copier en .env (jamais commité). Toutes les valeurs ont un défaut fonctionnel dans docker-compose.yml.

# --- Base de données ---
POSTGRES_USER=reif
POSTGRES_PASSWORD=reif
POSTGRES_DB=reif
DB_PORT=5432
# URL utilisée par l'API/worker À L'INTÉRIEUR du réseau Docker (hôte = db).
DATABASE_URL=postgresql+psycopg://reif:reif@db:5432/reif

# --- Application ---
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501
ADMINER_PORT=8080
API_URL=http://api:8000

# --- Collecte responsable ---
# User-agent honnête et identifiable (jamais d'usurpation, §32). Adaptez le contact.
USER_AGENT=reif-observatory/0.1 (+https://example.org/contact)
# Intervalle par défaut entre deux passes de rafraîchissement (secondes).
COLLECTION_INTERVAL=86400
